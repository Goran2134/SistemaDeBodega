<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:padding="14dp"
    android:layout_marginBottom="10dp"
    android:elevation="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp">

        <TextView
            android:id="@+id/tvTipoMovimientoItem"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="ENTRADA"
            android:textColor="#0284C7"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvFechaItem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2026-11-08 21:00:00"
            android:textColor="#667085"
            android:textSize="12sp" />

    </LinearLayout>

    <TextView
        android:id="@+id/tvProductoMovimientoItem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Nombre del Producto (SKU)"
        android:textColor="#1E293B"
        android:textSize="15sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="4dp">

        <TextView
            android:id="@+id/tvCantidadItem"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Cantidad: +50"
            android:textColor="#0F766E"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvMotivoItem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Motivo: Compra"
            android:textColor="#475569"
            android:textSize="13sp" />

    </LinearLayout>

    <TextView
        android:id="@+id/tvObservacionesItem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Observaciones: Proveedor X"
        android:textColor="#64748B"
        android:textSize="12sp"
        android:visibility="gone" />

</LinearLayout>
