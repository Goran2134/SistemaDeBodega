<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:text="Registrar Nuevo Usuario"
        android:textColor="@color/primary"
        android:textSize="22sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etNombreCompletoReg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:background="@android:drawable/editbox_background_normal"
        android:hint="@string/hint_nombre_completo"
        android:inputType="textPersonName"
        android:padding="14dp" />

    <EditText
        android:id="@+id/etUsernameReg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:background="@android:drawable/editbox_background_normal"
        android:hint="@string/hint_username"
        android:inputType="text"
        android:padding="14dp" />

    <EditText
        android:id="@+id/etPasswordReg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:background="@android:drawable/editbox_background_normal"
        android:hint="@string/hint_password"
        android:inputType="textPassword"
        android:padding="14dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="Asignar Rol:"
        android:textColor="@color/black"
        android:textSize="14sp" />

    <Spinner
        android:id="@+id/spinnerRoles"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:padding="8dp"
        android:background="@android:drawable/btn_dropdown" />

    <Button
        android:id="@+id/btnGuardarUsuario"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/primary"
        android:padding="14dp"
        android:text="Guardar Usuario"
        android:textColor="@color/white"
        android:textSize="16sp" />

</LinearLayout>