<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="@string/cat_titulo"
        android:textColor="@color/primary"
        android:textSize="22sp"
        android:textStyle="bold" />

    <!-- Formulario de Registro -->
    <EditText
        android:id="@+id/etNombreCategoriaReg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:background="@android:drawable/editbox_background_normal"
        android:hint="@string/hint_nombre_categoria"
        android:inputType="text"
        android:padding="12dp" />

    <EditText
        android:id="@+id/etDescCategoriaReg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:background="@android:drawable/editbox_background_normal"
        android:hint="@string/hint_desc_categoria"
        android:inputType="text"
        android:padding="12dp" />

    <Button
        android:id="@+id/btnRegistrarCategoria"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:backgroundTint="@color/primary"
        android:padding="12dp"
        android:text="@string/btn_registrar_categoria"
        android:textColor="@color/white"
        android:textSize="16sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="Categorías Activas"
        android:textColor="@color/black"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- Listado Reactivo -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCategorias"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</LinearLayout>