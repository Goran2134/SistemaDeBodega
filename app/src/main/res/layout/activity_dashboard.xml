<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvBienvenidaDashboard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:text="@string/dashboard_titulo"
        android:textColor="@color/primary"
        android:textSize="24sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnMenuUsuarios"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:backgroundTint="@color/primary"
        android:padding="14dp"
        android:text="@string/menu_usuarios"
        android:textColor="@color/white"
        android:textSize="16sp" />

    <Button
        android:id="@+id/btnMenuCategorias"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:backgroundTint="@color/primary"
        android:padding="14dp"
        android:text="@string/menu_categorias"
        android:textColor="@color/white"
        android:textSize="16sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <Button
        android:id="@+id/btnCerrarSesion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/error"
        android:padding="14dp"
        android:text="@string/menu_cerrar_sesion"
        android:textColor="@color/white"
        android:textSize="16sp" />

</LinearLayout>