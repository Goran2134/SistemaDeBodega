<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F3F5F7">

    <!-- ENCABEZADO PRINCIPAL -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="20dp">

        <TextView
            android:id="@+id/tvBienvenidaDashboard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/dashboard_titulo"
            android:textColor="#172B4D"
            android:textSize="25sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Panel de administración del sistema"
            android:textColor="#667085"
            android:textSize="13sp" />

    </LinearLayout>

    <!-- LÍNEA DIVISORIA -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#DDE3EA" />

    <!-- CONTENIDO PRINCIPAL -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- SECCIÓN DE NAVEGACIÓN -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Módulos del sistema"
            android:textColor="#1E293B"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="5dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Seleccione un módulo para administrar su información."
            android:textColor="#7A8699"
            android:textSize="12sp"
            android:layout_marginBottom="22dp" />

        <!-- MÓDULO DE USUARIOS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="18dp"
            android:elevation="2dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Administración de usuarios"
                android:textColor="#1E293B"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Gestione los usuarios y sus permisos de acceso al sistema."
                android:textColor="#7A8699"
                android:textSize="12sp"
                android:layout_marginBottom="18dp" />

            <Button
                android:id="@+id/btnMenuUsuarios"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:backgroundTint="#243B53"
                android:text="@string/menu_usuarios"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:elevation="0dp" />

        </LinearLayout>

        <!-- MÓDULO DE CATEGORÍAS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="18dp"
            android:elevation="2dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Administración de categorías"
                android:textColor="#1E293B"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Organice y administre las categorías de productos del inventario."
                android:textColor="#7A8699"
                android:textSize="12sp"
                android:layout_marginBottom="18dp" />

            <Button
                android:id="@+id/btnMenuCategorias"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:backgroundTint="#243B53"
                android:text="@string/menu_categorias"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:elevation="0dp" />

        </LinearLayout>

        <!-- ESPACIO FLEXIBLE -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- SECCIÓN DE SESIÓN -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#D8DEE6"
            android:layout_marginBottom="18dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sesión de usuario"
            android:textColor="#344054"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <!-- CERRAR SESIÓN -->
        <Button
            android:id="@+id/btnCerrarSesion"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:backgroundTint="#B42318"
            android:text="@string/menu_cerrar_sesion"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:elevation="0dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="Sistema de Bodega · Panel de administración"
            android:textColor="#98A2B3"
            android:textSize="11sp" />

    </LinearLayout>

</LinearLayout>
