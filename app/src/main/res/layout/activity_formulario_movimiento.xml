<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F5F7"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tvTituloFormMovimiento"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Registrar Movimiento"
            android:textColor="#172B4D"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:elevation="2dp">

            <!-- SELECCIONAR PRODUCTO -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Seleccionar Producto *"
                android:textColor="#1E293B"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <Spinner
                android:id="@+id/spProductosMovimiento"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@android:drawable/btn_dropdown"
                android:layout_marginBottom="14dp" />

            <!-- STOCK ACTUAL -->
            <TextView
                android:id="@+id/tvStockActualForm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Stock actual disponible: 0"
                android:textColor="#0F766E"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp" />

            <!-- CANTIDAD -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cantidad a mover *"
                android:textColor="#1E293B"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etCantidadMovimiento"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:inputType="number"
                android:hint="Ej. 10"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:background="@android:drawable/editbox_background_normal"
                android:layout_marginBottom="14dp"
                android:textSize="14sp" />

            <!-- MOTIVO -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Motivo (Opcional)"
                android:textColor="#1E293B"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etMotivoMovimiento"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Ej. Compra, Venta, Ajuste..."
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:background="@android:drawable/editbox_background_normal"
                android:layout_marginBottom="14dp"
                android:textSize="14sp" />

            <!-- OBSERVACIONES / PROVEEDOR / ÁREA -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Observaciones / Proveedor / Área (Opcional)"
                android:textColor="#1E293B"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etObservacionesMovimiento"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:gravity="top|start"
                android:hint="Detalles adicionales..."
                android:padding="12dp"
                android:background="@android:drawable/editbox_background_normal"
                android:layout_marginBottom="24dp"
                android:textSize="14sp" />

            <!-- BOTONES -->
            <Button
                android:id="@+id/btnConfirmarMovimiento"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:backgroundTint="#243B53"
                android:text="Confirmar Operación"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp"
                android:elevation="0dp" />

            <Button
                android:id="@+id/btnCancelarMovimientoForm"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:backgroundTint="#B42318"
                android:text="Cancelar"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:elevation="0dp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
