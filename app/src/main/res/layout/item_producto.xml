<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="#FFFFFF"
    android:elevation="2dp"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- NOMBRE Y ESTADO -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvNombreProducto"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Nombre del producto"
            android:textColor="#172B4D"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvEstadoProducto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Activo"
            android:textColor="#027A48"
            android:textSize="12sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- CÓDIGO SKU -->
    <TextView
        android:id="@+id/tvSkuProducto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="SKU: PROD-001"
        android:textColor="#475467"
        android:textSize="13sp" />

    <!-- DESCRIPCIÓN -->
    <TextView
        android:id="@+id/tvDescripcionProducto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Descripción del producto"
        android:textColor="#667085"
        android:textSize="13sp" />

    <!-- STOCK -->
    <TextView
        android:id="@+id/tvStockProducto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Stock actual: 0"
        android:textColor="#344054"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- DIVISOR -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="12dp"
        android:background="#E4E7EC" />

    <!-- ACCIONES -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnEditarProducto"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:backgroundTint="#243B53"
            android:text="Editar"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:elevation="0dp" />

        <Button
            android:id="@+id/btnDeshabilitarProducto"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:backgroundTint="#B42318"
            android:text="Deshabilitar"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:elevation="0dp" />

    </LinearLayout>

</LinearLayout>
