<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#243B53">

    <!-- CONTENIDO CENTRAL -->
    <LinearLayout
        android:id="@+id/contenidoBienvenida"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="28dp"
        android:paddingEnd="28dp">

        <!-- IDENTIFICADOR DEL SISTEMA -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PLATAFORMA DE ADMINISTRACIÓN"
            android:textColor="#B8C7D9"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.16"
            android:gravity="center"
            android:layout_marginBottom="18dp" />

        <!-- TÍTULO PRINCIPAL -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="#FFFFFF"
            android:textSize="32sp"
            android:textStyle="bold"
            android:gravity="center"
            android:letterSpacing="0.02" />

        <!-- LÍNEA DECORATIVA -->
        <View
            android:layout_width="64dp"
            android:layout_height="3dp"
            android:background="#8FAFC9"
            android:layout_gravity="center"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="22dp" />

        <!-- ESLOGAN -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/slogan_bienvenida"
            android:textColor="#D5DFEA"
            android:textSize="16sp"
            android:gravity="center"
            android:lineSpacingExtra="4dp" />

    </LinearLayout>

    <!-- PIE DE PÁGINA -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingBottom="36dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#40566D"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SISTEMA DE GESTIÓN DE BODEGA"
            android:textColor="#B8C7D9"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.10"
            android:gravity="center" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Control y administración de inventario"
            android:textColor="#91A5BA"
            android:textSize="11sp"
            android:gravity="center" />

    </LinearLayout>

</RelativeLayout>
