<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- PERMISO DE INTERNET PARA GOOGLE MAPS -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- PERMISOS DE UBICACIÓN GPS -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- CÁMARA PARA ESCANEAR CÓDIGOS DE BARRAS -->
    <uses-permission android:name="android.permission.CAMERA" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SistemaDeBodega">

        <!-- API DE GOOGLE MAPS -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="AIzaSyCq4JM--e0DBKAws3xNkNzGIcKaT2ZiNsc" />

        <!-- PANTALLA INICIAL -->
        <activity
            android:name=".Bienvenida"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- INICIO DE SESIÓN -->
        <activity
            android:name=".LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- PANEL PRINCIPAL -->
        <activity
            android:name=".DashboardActivity"
            android:exported="false" />

        <!-- GESTIÓN DE CATEGORÍAS -->
        <activity
            android:name=".CategoriasActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- GESTIÓN DE PRODUCTOS -->
        <activity
            android:name=".ProductosActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- REGISTRAR PRODUCTOS -->
        <activity
            android:name=".FormularioProductoActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- MOVIMIENTOS DE BODEGA -->
        <activity
            android:name=".MovimientosActivity"
            android:exported="false" />

        <!-- FORMULARIO MOVIMIENTO (ENTRADA / SALIDA) -->
        <activity
            android:name=".FormularioMovimientoActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- INFORME DE STOCK (CU-06) -->
        <activity
            android:name=".InformeStockActivity"
            android:exported="false" />

        <!-- GESTIÓN DE USUARIOS -->
        <activity
            android:name=".UsuariosActivity"
            android:exported="false" />

        <!-- REGISTRAR USUARIOS -->
        <activity
            android:name=".RegistrarUsuarioActivity"
            android:exported="false" />

        <!-- CONFIGURAR UBICACIÓN DE LA EMPRESA (RF-24) -->
        <activity
            android:name=".UbicacionEmpresaActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
    </application>

</manifest>