<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SistemaDeBodega">

        <!-- PANTALLA INICIAL -->
        <activity
            android:name=".Bienvenida"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- INICIO DE SESIÓN -->
        <activity
            android:name=".LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- PANEL PRINCIPAL -->
        <activity
            android:name=".DashboardActivity"
            android:exported="false" />

        <!-- GESTIÓN DE CATEGORÍAS -->
        <activity
            android:name=".CategoriasActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- GESTIÓN DE PRODUCTOS -->
        <activity
            android:name=".ProductosActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- REGISTRAR PRODUCTOS -->
        <activity
            android:name=".FormularioProductoActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- GESTIÓN DE USUARIOS -->
        <activity
            android:name=".UsuariosActivity"
            android:exported="false" />

        <!-- REGISTRAR USUARIOS -->
        <activity
            android:name=".RegistrarUsuarioActivity"
            android:exported="false" />

    </application>

</manifest>
